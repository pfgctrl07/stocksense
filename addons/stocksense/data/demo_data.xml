<odoo noupdate="1">
    <!-- noupdate=1: this is seed/reference data, not config. Without it, re-running
         `-u stocksense` on a DB that already has these quants crashes with
         "Quant's editing is restricted" since Odoo blocks direct writes to
         existing stock.quant records outside the normal stock-move flow. -->
    <!-- Categories -->
    <record id="category_raw_materials" model="product.category">
        <field name="name">Raw Materials</field>
        <!-- FEFO: for lot-tracked products in this category, the oldest/nearest-
             to-expire batch is picked automatically on delivery -->
        <field name="removal_strategy_id" ref="product_expiry.removal_fefo"/>
    </record>
    <record id="category_finished_goods" model="product.category">
        <field name="name">Finished Goods</field>
    </record>

    <!-- Second location: used to demo Internal Transfers -->
    <record id="location_production_rack" model="stock.location">
        <field name="name">Production Rack</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="ss_x">0</field>
        <field name="ss_y">0</field>
        <field name="ss_z">1</field>
    </record>

    <!-- Addressable storage slots: (floor-x, floor-y, height) — the 3-number
         Cartesian address used by the space-optimization suggestions -->
    <record id="location_slot_1_1_1" model="stock.location">
        <field name="name">Slot (1,1,1)</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="ss_x">1</field>
        <field name="ss_y">1</field>
        <field name="ss_z">1</field>
        <field name="ss_is_slot" eval="True"/>
    </record>
    <record id="location_slot_1_2_1" model="stock.location">
        <field name="name">Slot (1,2,1)</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="ss_x">1</field>
        <field name="ss_y">2</field>
        <field name="ss_z">1</field>
        <field name="ss_is_slot" eval="True"/>
    </record>
    <record id="location_slot_2_1_1" model="stock.location">
        <field name="name">Slot (2,1,1)</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="ss_x">2</field>
        <field name="ss_y">1</field>
        <field name="ss_z">1</field>
        <field name="ss_is_slot" eval="True"/>
    </record>
    <record id="location_slot_2_2_1" model="stock.location">
        <field name="name">Slot (2,2,1)</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="ss_x">2</field>
        <field name="ss_y">2</field>
        <field name="ss_z">1</field>
        <field name="ss_is_slot" eval="True"/>
    </record>
    <record id="location_slot_1_1_2" model="stock.location">
        <field name="name">Slot (1,1,2)</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="ss_x">1</field>
        <field name="ss_y">1</field>
        <field name="ss_z">2</field>
        <field name="ss_is_slot" eval="True"/>
    </record>
    <record id="location_slot_2_2_2" model="stock.location">
        <field name="name">Slot (2,2,2)</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="ss_x">2</field>
        <field name="ss_y">2</field>
        <field name="ss_z">2</field>
        <field name="ss_is_slot" eval="True"/>
    </record>

    <!-- Products matching the PS worked example -->
    <record id="product_steel" model="product.template">
        <field name="name">Steel Rods</field>
        <field name="default_code">STL-001</field>
        <field name="barcode">8901000000011</field>
        <field name="categ_id" ref="category_raw_materials"/>
        <field name="type">product</field>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="uom_po_id" ref="uom.product_uom_kgm"/>
        <field name="list_price">50.0</field>
    </record>

    <record id="product_chairs" model="product.template">
        <field name="name">Chairs</field>
        <field name="default_code">CHR-001</field>
        <field name="barcode">8901000000028</field>
        <field name="categ_id" ref="category_finished_goods"/>
        <field name="type">product</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="uom_po_id" ref="uom.product_uom_unit"/>
        <field name="list_price">1200.0</field>
    </record>

    <!-- A few extra products so the dashboard/list views aren't empty -->
    <record id="product_wood_planks" model="product.template">
        <field name="name">Wood Planks</field>
        <field name="default_code">WPL-001</field>
        <field name="barcode">8901000000035</field>
        <field name="categ_id" ref="category_raw_materials"/>
        <field name="type">product</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="uom_po_id" ref="uom.product_uom_unit"/>
        <field name="list_price">15.0</field>
        <!-- Lot + expiry tracking: demonstrates FEFO removal (oldest/nearest-
             expiring batch goes out first on delivery) -->
        <field name="tracking">lot</field>
        <field name="use_expiration_date" eval="True"/>
        <field name="expiration_time">30</field>
    </record>

    <record id="product_screws" model="product.template">
        <field name="name">Screws (box of 100)</field>
        <field name="default_code">SCR-001</field>
        <field name="barcode">8901000000042</field>
        <field name="categ_id" ref="category_raw_materials"/>
        <field name="type">product</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="uom_po_id" ref="uom.product_uom_unit"/>
        <field name="list_price">5.0</field>
    </record>

    <record id="product_tables" model="product.template">
        <field name="name">Tables</field>
        <field name="default_code">TBL-001</field>
        <field name="barcode">8901000000059</field>
        <field name="categ_id" ref="category_finished_goods"/>
        <field name="type">product</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="uom_po_id" ref="uom.product_uom_unit"/>
        <field name="list_price">3000.0</field>
    </record>

    <!-- Initial stock so the dashboard isn't empty at first login -->
    <record id="quant_wood_planks" model="stock.quant">
        <field name="product_id" ref="product_wood_planks"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="quantity">200</field>
    </record>

    <record id="quant_screws" model="stock.quant">
        <field name="product_id" ref="product_screws"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="quantity">5</field>
    </record>

    <record id="quant_tables" model="stock.quant">
        <field name="product_id" ref="product_tables"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="quantity">12</field>
    </record>
</odoo>
