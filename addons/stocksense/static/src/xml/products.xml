<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="stocksense.Products" owl="1">
    <div class="ss-app">
      <div class="ss-page-header">
        <h2><i class="fa fa-cubes"/> Product Intelligence</h2>
        <div class="ss-header-actions">
          <button class="ss-btn ss-btn-primary" t-on-click="() => this.openAddProduct()">
            <i class="fa fa-plus"/> New Product
          </button>
          <button class="ss-btn ss-btn-outline" t-on-click="() => this.openScanner()">
            <i class="fa fa-camera"/> Scan Barcode
          </button>
          <button class="ss-btn ss-btn-outline" t-on-click="() => this.toggleLayout()">
            <i class="fa fa-th"/>
            <t t-if="state.showLayout">Hide Warehouse Layout</t>
            <t t-else="">Warehouse Layout</t>
          </button>
          <button class="ss-btn ss-btn-outline" t-on-click="() => this.toggleSummary()">
            <i class="fa fa-calendar"/>
            <t t-if="state.showSummary">Hide Daily Summary</t>
            <t t-else="">Daily Summary</t>
          </button>
        </div>
      </div>

      <div t-if="state.showAddProduct" class="ss-modal-overlay">
        <div class="ss-modal">
          <div class="ss-panel-header">
            <h4><i class="fa fa-plus"/> New Product</h4>
            <button class="ss-btn ss-btn-outline ss-btn-sm" t-on-click="() => this.closeAddProduct()">Close</button>
          </div>

          <p t-if="state.addError" class="ss-badge ss-badge-danger mb-2" style="display:block; white-space:normal;">
            <t t-esc="state.addError"/>
          </p>

          <div class="mb-2">
            <label class="ss-hint">Product Name *</label>
            <input type="text" class="ss-input" style="width:100%;" t-att-value="state.newProduct.name"
                   t-on-input="(ev) => this.onNewProductField('name', ev)"/>
          </div>

          <div class="d-flex mb-2" style="gap: 8px;">
            <div style="flex:1;">
              <label class="ss-hint">SKU</label>
              <input type="text" class="ss-input" style="width:100%;" t-att-value="state.newProduct.sku"
                     t-on-input="(ev) => this.onNewProductField('sku', ev)"/>
            </div>
            <div style="flex:1;">
              <label class="ss-hint">Barcode</label>
              <input type="text" class="ss-input" style="width:100%;" t-att-value="state.newProduct.barcode"
                     t-on-input="(ev) => this.onNewProductField('barcode', ev)"/>
            </div>
          </div>

          <div class="d-flex mb-2" style="gap: 8px;">
            <div style="flex:1;">
              <label class="ss-hint">Category</label>
              <select class="ss-select" style="width:100%;" t-on-change="(ev) => this.onNewProductField('category_id', ev)">
                <option value="">Select category...</option>
                <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                  <option t-att-value="cat.id" t-esc="cat.name"/>
                </t>
              </select>
            </div>
            <div style="flex:1;">
              <label class="ss-hint">Unit of Measure</label>
              <select class="ss-select" style="width:100%;" t-on-change="(ev) => this.onNewProductField('uom_id', ev)">
                <option value="">Select unit...</option>
                <t t-foreach="state.uomOptions" t-as="uom" t-key="uom.id">
                  <option t-att-value="uom.id" t-esc="uom.name"/>
                </t>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="ss-hint">Sales Price</label>
            <input type="number" class="ss-input" style="width:100%;" t-att-value="state.newProduct.list_price"
                   t-on-input="(ev) => this.onNewProductField('list_price', ev)"/>
          </div>

          <div class="mb-3" style="border-top: 1px solid var(--ss-border); padding-top: 12px;">
            <label style="display:flex; align-items:center; gap: 8px; cursor:pointer;">
              <input type="checkbox" t-att-checked="state.newProduct.track_expiry"
                     t-on-change="(ev) => this.onNewProductField('track_expiry', ev)"/>
              <span>Track expiry date for this product</span>
            </label>
            <div t-if="state.newProduct.track_expiry" class="mt-2">
              <label class="ss-hint">Expires after (days from receipt)</label>
              <input type="number" class="ss-input" style="width:100%;" t-att-value="state.newProduct.expiration_days"
                     t-on-input="(ev) => this.onNewProductField('expiration_days', ev)"/>
            </div>
          </div>

          <button class="ss-btn ss-btn-primary" style="width:100%; justify-content:center;" t-on-click="() => this.submitNewProduct()">
            <i class="fa fa-check"/> Create Product
          </button>
        </div>
      </div>

      <div t-if="state.showScanner" class="ss-modal-overlay">
        <div class="ss-modal">
          <div class="ss-panel-header">
            <h4><i class="fa fa-camera"/> Scan Barcode</h4>
            <button class="ss-btn ss-btn-outline ss-btn-sm" t-on-click="() => this.closeScanner()">Close</button>
          </div>
          <t t-if="state.scannerSupported">
            <video t-ref="scannerVideo" class="ss-modal-video" autoplay="autoplay" playsinline="playsinline"></video>
          </t>
          <p t-if="state.scanStatus" class="ss-badge ss-badge-primary mt-2"><t t-esc="state.scanStatus"/></p>
          <div class="mt-3">
            <label class="ss-hint">Camera not working? Enter the barcode manually:</label>
            <div class="d-flex mt-1" style="gap: 8px;">
              <input type="text" class="ss-input" style="flex: 1;" t-att-value="state.manualBarcode"
                     t-on-input="(ev) => this.onManualBarcodeInput(ev)"/>
              <button class="ss-btn ss-btn-primary" t-on-click="() => this.onManualBarcodeSubmit()">Look up</button>
            </div>
          </div>
        </div>
      </div>

      <div t-if="state.showLayout" class="ss-panel">
        <div class="ss-card-title"><i class="fa fa-th"/> Warehouse Layout (X, Y, Height)</div>
        <table class="ss-table">
          <thead>
            <tr><th>Slot</th><th>X</th><th>Y</th><th>Height (Z)</th><th>Currently Holding</th></tr>
          </thead>
          <tbody>
            <t t-foreach="state.layout" t-as="slot" t-key="slot.location_id">
              <tr>
                <td t-esc="slot.name"/>
                <td t-esc="slot.x"/>
                <td t-esc="slot.y"/>
                <td t-esc="slot.z"/>
                <td>
                  <span t-if="slot.occupant" class="ss-badge ss-badge-primary" t-esc="slot.occupant"/>
                  <span t-else="" class="ss-muted">Empty</span>
                </td>
              </tr>
            </t>
          </tbody>
        </table>

        <div class="ss-card-title mt-4"><i class="fa fa-magic"/> Suggested Optimal Placement</div>
        <table class="ss-table">
          <thead>
            <tr><th>Product</th><th>Velocity/day</th><th>Current Location</th><th>Suggested Slot</th><th>Reason</th></tr>
          </thead>
          <tbody>
            <t t-foreach="state.optimization" t-as="opt" t-key="opt_index">
              <tr>
                <td t-esc="opt.product"/>
                <td t-esc="opt.velocity"/>
                <td t-esc="opt.current_location"/>
                <td><t t-esc="opt.suggested_slot"/> <t t-esc="opt.suggested_coordinate"/></td>
                <td><span class="ss-hint" t-esc="opt.reason"/></td>
              </tr>
            </t>
          </tbody>
        </table>
      </div>

      <div t-if="state.showSummary" class="ss-panel">
        <div class="ss-card-title"><i class="fa fa-calendar"/> Daily Summary — <t t-esc="state.summary.date"/></div>
        <div class="ss-kpi-row-sm">
          <div class="ss-kpi-card">
            <div class="ss-kpi-icon"><i class="fa fa-arrow-down"/></div>
            <div>
              <div class="ss-kpi-value" t-esc="state.summary.total_received_today"/>
              <div class="ss-kpi-label">Received Today</div>
            </div>
          </div>
          <div class="ss-kpi-card">
            <div class="ss-kpi-icon"><i class="fa fa-arrow-up"/></div>
            <div>
              <div class="ss-kpi-value" t-esc="state.summary.total_delivered_today"/>
              <div class="ss-kpi-label">Delivered Today</div>
            </div>
          </div>
        </div>
        <table class="ss-table">
          <thead>
            <tr><th>Product</th><th>Received Today</th><th>Delivered Today</th><th>Current Qty</th><th>Status</th></tr>
          </thead>
          <tbody>
            <t t-foreach="state.summary.products" t-as="row" t-key="row.name">
              <tr>
                <td t-esc="row.name"/>
                <td t-esc="row.received_today"/>
                <td t-esc="row.delivered_today"/>
                <td t-esc="row.current_qty"/>
                <td>
                  <span t-if="row.stale and row.days_idle === null" class="ss-badge ss-badge-danger">Never moved</span>
                  <span t-elif="row.stale" class="ss-badge ss-badge-danger">Idle <t t-esc="row.days_idle"/>d</span>
                  <span t-else="" class="ss-badge ss-badge-success">Active</span>
                </td>
              </tr>
            </t>
          </tbody>
        </table>

        <div t-if="state.transferSuggestions.length" class="mt-3">
          <div class="ss-card-title"><i class="fa fa-exchange"/> Transfer Suggestions</div>
          <t t-foreach="state.transferSuggestions" t-as="sug" t-key="sug_index">
            <div class="ss-badge ss-badge-primary mb-2" style="display:block; white-space:normal; padding:10px 14px;">
              <strong t-esc="sug.product"/>: move <t t-esc="sug.suggested_qty"/> from
              <t t-esc="sug.from_location"/> to <t t-esc="sug.to_location"/>.
              <div class="ss-hint" t-esc="sug.reason"/>
            </div>
          </t>
        </div>
        <p t-else="" class="ss-muted">No location imbalance detected — no transfers suggested right now.</p>
      </div>

      <p t-if="state.removeStatus" class="ss-badge ss-badge-primary mb-3" style="display:block; white-space:normal; padding:10px 14px;">
        <t t-esc="state.removeStatus"/>
      </p>

      <div class="ss-card">
        <div class="ss-filters">
          <div class="ss-search-wrap">
            <i class="fa fa-search"/>
            <input type="text" class="ss-input" placeholder="Search by name, SKU, category, or location..."
                   t-on-input="onSearchInput"/>
          </div>
          <select class="ss-select" t-on-change="onCategoryChange">
            <option value="all">All Categories</option>
            <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
              <option t-att-value="cat.id" t-esc="cat.name"/>
            </t>
          </select>
        </div>

        <div style="overflow-x: auto;">
        <table class="ss-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>SKU</th>
              <th>Category</th>
              <th>Location(s)</th>
              <th>Qty</th>
              <th>Expiry</th>
              <th>Reorder Signal</th>
              <th>Physical Count</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="state.products" t-as="product" t-key="product.id">
              <tr t-att-class="product.reorder.alert ? 'ss-row-alert' : ''">
                <td><strong t-esc="product.name"/></td>
                <td t-esc="product.sku"/>
                <td t-esc="product.category"/>
                <td t-esc="product.locations"/>
                <td>
                  <span t-esc="product.qty_available"/> <span t-esc="product.uom"/>
                  <div t-if="product.movement.stale" class="ss-hint ss-hint-danger">
                    <t t-if="product.movement.days_idle === null">Never moved</t>
                    <t t-else="">Idle <t t-esc="product.movement.days_idle"/>d</t>
                  </div>
                </td>
                <td>
                  <span t-if="product.expiry.nearest_expiry === '-'" class="ss-muted">-</span>
                  <span t-else="" t-att-class="'ss-badge ' + (product.expiry.is_expired ? 'ss-badge-danger' : 'ss-badge-success')">
                    <t t-esc="product.expiry.nearest_expiry"/>
                  </span>
                </td>
                <td>
                  <t t-if="product.reorder.days_left !== null">
                    <span t-att-class="'ss-badge ' + (product.reorder.alert ? 'ss-badge-danger' : 'ss-badge-success')">
                      <t t-esc="product.reorder.days_left"/> days left
                    </span>
                    <div t-if="product.reorder.alert" class="ss-hint ss-hint-danger">
                      Suggest reorder: <t t-esc="product.reorder.suggested_reorder_qty"/> <t t-esc="product.uom"/>
                    </div>
                  </t>
                  <t t-else="">
                    <span t-if="product.reorder.alert" class="ss-badge ss-badge-danger">Out of stock</span>
                    <span t-else="" class="ss-badge ss-badge-neutral">No recent usage</span>
                  </t>
                </td>
                <td>
                  <input type="number" class="ss-mini-input"
                         t-att-value="state.counts[product.id]"
                         t-on-input="(ev) => this.onCountInput(product.id, ev)"/>
                  <div t-if="countDiff(product) !== null" class="ss-hint"
                       t-att-class="countDiff(product) !== 0 ? 'ss-hint-danger' : 'ss-hint-success'">
                    Diff: <t t-esc="countDiff(product)"/>
                  </div>
                  <button class="ss-btn ss-btn-outline ss-btn-sm mt-1" t-on-click="() => this.onApplyCount(product)">
                    Apply Count
                  </button>
                </td>
                <td>
                  <div class="ss-row-actions">
                    <input type="number" class="ss-mini-input"
                           t-att-value="state.qty[product.id]"
                           t-on-input="(ev) => this.onQtyInput(product.id, ev)"/>
                    <button class="ss-btn ss-btn-success ss-btn-sm" t-on-click="() => this.onQuickAdd(product.id)"><i class="fa fa-plus"/></button>
                    <button class="ss-btn ss-btn-warning ss-btn-sm" t-on-click="() => this.onQuickRemove(product.id)"><i class="fa fa-minus"/></button>
                    <button class="ss-btn ss-btn-danger ss-btn-sm" t-on-click="() => this.onReportDamage(product.id)"><i class="fa fa-exclamation-triangle"/> Damage</button>
                    <button class="ss-btn ss-btn-outline ss-btn-sm" t-on-click="() => this.onViewHistory(product)"><i class="fa fa-history"/> History</button>
                    <t t-if="state.confirmRemoveId === product.id">
                      <span class="ss-hint ss-hint-danger">Remove permanently?</span>
                      <button class="ss-btn ss-btn-danger ss-btn-sm" t-on-click="() => this.confirmRemoveProduct(product.id)">Yes, remove</button>
                      <button class="ss-btn ss-btn-outline ss-btn-sm" t-on-click="() => this.cancelRemoveProduct()">Cancel</button>
                    </t>
                    <button t-else="" class="ss-btn ss-btn-outline ss-btn-sm" t-on-click="() => this.askRemoveProduct(product.id)"><i class="fa fa-trash"/> Remove</button>
                  </div>
                </td>
              </tr>
            </t>
          </tbody>
        </table>
        </div>
      </div>

      <div t-if="state.timeline.productId" class="ss-panel">
        <div class="ss-panel-header">
          <h4><i class="fa fa-history"/> History: <t t-esc="state.timeline.productName"/></h4>
          <button class="ss-btn ss-btn-outline ss-btn-sm" t-on-click="() => this.closeTimeline()">Close</button>
        </div>
        <table class="ss-table">
          <thead>
            <tr><th>Date</th><th>Reference</th><th>From</th><th>To</th><th>Qty</th></tr>
          </thead>
          <tbody>
            <t t-foreach="state.timeline.entries" t-as="entry" t-key="entry_index">
              <tr>
                <td t-esc="entry.date"/>
                <td t-esc="entry.reference"/>
                <td t-esc="entry.from_location"/>
                <td t-esc="entry.to_location"/>
                <td t-esc="entry.qty"/>
              </tr>
            </t>
          </tbody>
        </table>
      </div>
    </div>
  </t>
</templates>
